# dependencies
node_modules/

# build output
dist/

# QA artefacts — regenerate with `npm run survey` / `npm run jumptest`
shots/survey/
shots/jumptest/

# Kept on disk, deliberately not committed. Pushing anything under
# .github/workflows/ needs a token with the `workflow` scope, which this one
# lacks, so `git add -A` would stage it and then GitHub would reject the push.
# To enable auto-deploy on push: `gh auth refresh -s workflow`, delete the line
# below, commit the workflow, then point Pages at Actions instead of gh-pages.
# Until then `npm run deploy` is the publish path. See ARCHITECTURE.md.
.github/workflows/pages.yml

# local tooling
.claude/settings.local.json

# macOS
.DS_Store
